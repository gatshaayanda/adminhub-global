    html[data-bs-theme="dark"] :is(.profile-settings-card,.player-message-reader,.friend-card,.social-pulse-grid article,.rival-watch-grid article,.head-to-head,.comparison-grid article,.comparison-universe article,.social-private-rule,.social-empty-note,.preference-grid > div,.pool-progress article,.cross-desk-metrics article,.desk-sequence article,.recurring-patterns article,.beta-access-form,.agreement-check,.onboarding-contact-card,.preference-defaults-summary) :is(p,small,dt) { color: var(--bs-text-secondary); }
    html[data-bs-theme="dark"] :is(input,textarea,select) { border-color: var(--bs-border-strong); background: var(--bs-surface-raised); color: var(--bs-text); }
    html[data-bs-theme="dark"] :is(input,textarea)::placeholder { color: var(--bs-text-muted); }
    html[data-bs-theme="dark"] .chesscom-login-panel { border-color: var(--bs-border); background: var(--bs-surface); box-shadow: none; }
    html[data-bs-theme="dark"] .beta-agreement-card { border-color: var(--bs-border); background: var(--bs-surface); box-shadow: var(--bs-shadow-1); }
    html[data-bs-theme="dark"] .beta-agreement-card :is(h1,p,li,label) { color: var(--bs-text); }
    html[data-bs-theme="dark"] .agreement-mark { background: var(--bs-lime); color: var(--bs-on-lime); }
    html[data-bs-theme="dark"] .state-pill.ready { color: var(--bs-positive); }
    
    /* Lime remains an accent with fixed dark copy, including dark mode. */
    :is(.button-lime,.universal-score-card,.preview-open,.member-first-desk-note,.beta-request-success-mark,.agreement-mark,.info-card-icon,.metric-card.lime,.bs-surface-accent) :is(h1,h2,h3,h4,strong,p,span,small,svg) { color: var(--bs-on-lime); }
    
    /* Responsive system: mobile is composed, not compressed desktop. */
    @media (max-width: 1000px) {
      .universe-now-grid article:first-child { grid-column: auto; }
      .universal-cover { grid-template-columns: 1fr; }
      .universal-cover-copy { min-height: 420px; }
      .universal-score-card { min-height: 220px; }
    }
    
    @media (max-width: 900px) {
      .bs-theme-control-desktop { display: none; }
      .bs-theme-control-mobile { display: grid; margin-bottom: .55rem; padding-bottom: .65rem; border-bottom: 1px solid var(--bs-border); }
      .bs-theme-control-mobile .bs-theme-control-field { width: 100%; }
      .bs-theme-control-mobile select { flex: 1; width: 100%; }
      .masthead { min-height: 68px; gap: .75rem; }
      .brand-line { display: none; }
      .brand-mark { width: 38px; height: 38px; }
      .room-tab-nav { top: 69px; }
      .current-episode-stats > div { border-right: 0; border-bottom: 1px solid var(--bs-border); }
      .current-episode-stats > div:last-child { border-bottom: 0; }
      .beta-preview-hero { border-radius: 22px; }
    }
    
    @media (max-width: 680px) {
      .container { width: min(100% - 1rem, 1240px); }
      .personal-hero { padding-block: 2.25rem 3.25rem; }
      .personal-hero-copy h1 { font-size: clamp(2.55rem, 12vw, 4rem); line-height: .98; }
      .hero-username-card { margin-top: 1.35rem; padding: .7rem; border-radius: 16px; }
      .username-entry-row { grid-template-columns: auto minmax(0, 1fr); gap: 0; padding-bottom: .4rem; }
      .username-entry-row .button { grid-column: 1 / -1; width: calc(100% - .7rem); margin: .35rem; }
      .pipeline-preview { border-radius: 22px; }
      .universal-cover-copy { min-height: 380px; padding: 1.2rem; border-radius: 22px; }
      .universal-cover-copy h2 { font-size: clamp(2.35rem, 12vw, 3.5rem); }
      .universal-score-card { min-height: 190px; padding: 1.15rem; border-radius: 22px; }
      .universal-score-card > strong { font-size: clamp(3rem, 16vw, 4.5rem); }
      .universal-section { padding: 1.1rem; border-radius: 20px; }
      #what-mattered.universal-section, #focus-next.universal-section { padding: 1.25rem; }
      .universal-section-heading { display: grid; }
      .universal-section-heading > span { width: 32px; height: 32px; }
      .universal-metrics { grid-template-columns: 1fr 1fr; }
      .universal-timeline { grid-template-columns: 1fr 1fr; }
      .current-episode-card { padding: 1rem; border-radius: 20px; }
      .current-episode-heading h2 { font-size: clamp(2rem, 10vw, 3rem); }
      .current-episode-stats { grid-template-columns: 1fr 1fr; }
      .current-episode-card .return-loop-grid { grid-template-columns: 1fr; }
      .beta-preview-room { width: 100%; padding-inline: .5rem; }
      .beta-preview-hero, .beta-preview-week, .beta-preview-universe, .beta-preview-progress, .beta-preview-players, .beta-preview-return, .beta-preview-next { width: 100%; border-radius: 20px; }
      .beta-preview-primary-cta { width: 100%; }
      .public-player-identity { align-items: flex-start; }
      .public-coverage-lead { padding: 1rem; border-radius: 20px; }
      .room-tab-nav { margin-inline: -.25rem; padding-inline: .35rem; border-radius: 12px; }
    }
    
    @media (max-width: 390px) {
      .masthead { min-height: 62px; }
      .brand-name { font-size: 1.08rem; }
      .brand-mark { width: 34px; height: 34px; }
      .menu-button { width: 40px; height: 40px; }
      .personal-hero-copy h1 { font-size: 2.55rem; }
      .hero-deck { font-size: .96rem; }
      .universal-metrics, .current-episode-stats, .universal-timeline { grid-template-columns: 1fr; }
      .universal-player-bar { grid-template-columns: auto minmax(0, 1fr); }
      .universal-player-bar .private-access { grid-column: 1 / -1; width: fit-content; }
      .beta-preview-sticky-access { width: calc(100vw - 12px); bottom: max(8px, calc(env(safe-area-inset-bottom) + 6px)); }
      .room-tab-nav button { padding-inline: .68rem; }
    }
    
    /* ==========================================================
       G.2 Founder Newsroom 2.0 + operations console
       Founder-only hierarchy built on the G.1 semantic foundation.
       ========================================================== */
    .founder-newsroom-v2 .admin-heading,
    .founder-players-v2 .admin-heading { margin-bottom: .9rem; }
    .founder-ops-console { display: grid; gap: 1rem; margin-top: 1rem; }
    .founder-attention-section,
    .founder-live-metrics,
    .founder-validation-section,
    .founder-live-directory {
      padding: clamp(1rem, 2.5vw, 1.5rem);
      border: 1px solid var(--bs-border);
      border-radius: var(--bs-radius-md);
      background: var(--bs-surface);
      color: var(--bs-text-primary);
    }
    .founder-attention-section { border-top: 5px solid var(--bs-warning); }
    .founder-ops-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
    .founder-ops-heading h2 { margin-top: .25rem; color: var(--bs-text-primary); font-size: clamp(1.7rem, 3vw, 2.7rem); }
    .founder-ops-heading p:not(.kicker) { max-width: 72ch; margin-top: .35rem; color: var(--bs-text-secondary); }
    .founder-attention-grid { display: grid; grid-template-columns: repeat(5, minmax(0,1fr)); gap: .65rem; margin-top: 1rem; }
    .founder-attention-grid button {
      min-width: 0; min-height: 116px; display: flex; flex-direction: column; align-items: flex-start; justify-content: flex-end;
      padding: .85rem; border: 1px solid var(--bs-border); border-radius: var(--bs-radius-sm); background: var(--bs-surface-elevated); color: var(--bs-text-primary); text-align: left; cursor: pointer;
    }
    .founder-attention-grid button.has-attention { border-left: 5px solid var(--bs-warning); background: color-mix(in srgb, var(--bs-warning) 8%, var(--bs-surface)); }
    .founder-attention-grid span { color: var(--bs-text-secondary); font-size: .68rem; font-weight: 850; text-transform: uppercase; }
    .founder-attention-grid strong { margin-top: auto; color: var(--bs-text-primary); font-size: 2rem; }
    .founder-attention-grid small { margin-top: .2rem; color: var(--bs-text-muted); }
    .founder-attention-grid button:focus-visible,
    .founder-filter-strip button:focus-visible,
    .founder-ops-controls :is(input,select):focus-visible,
    .founder-pagination button:focus-visible,
    .founder-ops-details summary:focus-visible,
    .founder-followup-actions :is(button,select,a):focus-visible,
    .founder-secondary-group summary:focus-visible,
    .founder-management-disclosure summary:focus-visible,
    .founder-traffic-controls button:focus-visible,
    .founder-player-compact-card summary:focus-visible,
    .founder-player-search input:focus-visible { outline: 3px solid var(--bs-focus); outline-offset: 3px; }
    
    .founder-compact-metrics { display: grid; grid-template-columns: repeat(6, minmax(0,1fr)); gap: 1px; margin-top: 1rem; overflow: hidden; border: 1px solid var(--bs-border); border-radius: var(--bs-radius-sm); background: var(--bs-border); }
    .founder-compact-metrics article { min-width: 0; padding: .85rem; background: var(--bs-surface-elevated); }
    .founder-compact-metrics span,
    .founder-validation-grid span { display: block; color: var(--bs-text-muted); font-size: .61rem; font-weight: 850; letter-spacing: .05em; }
    .founder-compact-metrics strong,
    .founder-validation-grid strong { display: block; margin-top: .28rem; color: var(--bs-text-primary); font-size: clamp(1.35rem, 2.5vw, 2rem); }
    .founder-compact-metrics small { display: block; margin-top: .25rem; color: var(--bs-text-secondary); font-size: .62rem; }
    .founder-validation-grid { display: grid; grid-template-columns: repeat(8, minmax(0,1fr)); gap: .55rem; margin-top: 1rem; }
    .founder-validation-grid article { min-width: 0; padding: .75rem; border: 1px solid var(--bs-border); background: var(--bs-bg-subtle); }
    .founder-data-completeness { margin-top: .8rem; color: var(--bs-text-muted); font-size: .7rem; }
    
    .founder-ops-controls { display: grid; grid-template-columns: minmax(260px,1fr) minmax(180px,.35fr); gap: .7rem; margin-top: 1rem; }
    .founder-ops-controls label,
