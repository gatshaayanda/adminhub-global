      --bs-blue-readable: #1733b8;
      --bs-blue-soft: #e3e9ff;
      --bs-lime: #c9f65d;
      --bs-lime-readable: #53720e;
      --bs-lime-soft: #eef7d7;
      --bs-positive: #2f7d52;
      --bs-warning: #8a6210;
      --bs-danger: #c7432b;
      --bs-on-lime: #101923;
      --bs-shadow-1: 0 1px 2px rgba(16,25,35,.05), 0 8px 24px rgba(16,25,35,.05);
      --bs-shadow-2: 0 2px 5px rgba(16,25,35,.06), 0 18px 46px rgba(16,25,35,.09);
      --bs-radius-sm: 12px;
      --bs-radius-md: 20px;
      --bs-radius-lg: 30px;
    
      /* Backward-compatible presentation aliases. Keep --ink as the fixed dark brand surface. */
      --background: var(--bs-bg);
      --foreground: var(--bs-text);
      --surface: var(--bs-surface);
      --surface-2: var(--bs-bg-subtle);
      --surface-3: var(--bs-border);
      --paper: var(--bs-bg);
      --white: var(--bs-surface-raised);
      --border: var(--bs-border);
      --border-strong: var(--bs-border-strong);
      --ink-soft: var(--bs-text-secondary);
      --text-primary: var(--bs-text);
      --text-secondary: var(--bs-text-secondary);
      --text-muted: var(--bs-text-muted);
      --text-on-brand: var(--bs-text-on-dark);
      --signal-blue-dark: var(--bs-blue-readable);
      --brand-tint: var(--bs-blue-soft);
      --success: var(--bs-positive);
