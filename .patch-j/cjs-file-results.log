    .founder-player-search input { min-height: 44px; width: 100%; padding: .55rem .65rem; border: 1px solid var(--bs-border-strong); background: var(--bs-surface-elevated); color: var(--bs-text-primary); }
    .founder-filter-strip { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .75rem; }
    .founder-filter-strip button,
    .founder-traffic-controls button { min-height: 40px; padding: .5rem .65rem; border: 1px solid var(--bs-border); border-radius: 999px; background: var(--bs-surface-elevated); color: var(--bs-text-secondary); font-size: .64rem; font-weight: 850; cursor: pointer; }
    .founder-filter-strip button.active,
    .founder-traffic-controls button.active { border-color: var(--bs-surface-inverse); background: var(--bs-surface-inverse); color: var(--bs-text-on-inverse); }
    
    .founder-ops-table { margin-top: .8rem; border: 1px solid var(--bs-border); border-radius: var(--bs-radius-sm); overflow: hidden; }
    .founder-ops-table-head,
    .founder-ops-main-row { display: grid; grid-template-columns: minmax(120px,1.2fr) minmax(64px,.45fr) minmax(120px,1fr) minmax(85px,.7fr) minmax(86px,.7fr) minmax(110px,.9fr) minmax(110px,1fr) minmax(80px,.55fr); gap: .6rem; align-items: center; }
    .founder-ops-table-head { padding: .6rem .75rem; background: var(--bs-surface-inverse); color: var(--bs-text-on-inverse); font-size: .56rem; font-weight: 900; letter-spacing: .05em; }
    .founder-ops-row { border-top: 1px solid var(--bs-border); background: var(--bs-surface); color: var(--bs-text-primary); }
    .founder-ops-row:first-of-type { border-top: 0; }
    .founder-ops-main-row { padding: .75rem; }
