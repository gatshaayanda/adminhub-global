    function displayDate(value?: string, empty = "—") { if (!value) return empty; const parsed = Date.parse(value); return Number.isFinite(parsed) ? new Date(parsed).toLocaleDateString("en-GB", { day:"numeric", month:"short", year:"numeric" }) : empty; }
    function relativeSeen(value?: string) { if (!value) return "NEVER / NOT RECORDED"; const parsed=Date.parse(value); if(!Number.isFinite(parsed)) return "NOT RECORDED"; const days=Math.max(0,Math.floor((Date.now()-parsed)/(24*60*60*1000))); return days===0?"Today":days===1?"1d ago":`${days}d ago`; }
