    .founder-ops-main-row small { display: block; margin-top: .13rem; color: var(--bs-text-muted); font-size: .59rem; overflow-wrap: anywhere; }
    .founder-ops-main-row .button { min-height: 38px; padding: .5rem .6rem; font-size: .62rem; }
    .state-pill.error { border-color: var(--bs-danger); background: var(--bs-danger-surface); color: var(--bs-danger); }
    .founder-ops-details { border-top: 1px solid var(--bs-border); }
