    .founder-ops-detail-grid dl > div { min-width: 0; padding: .6rem; border: 1px solid var(--bs-border); background: var(--bs-surface-elevated); }
    .founder-ops-detail-grid dt { color: var(--bs-text-muted); font-size: .56rem; font-weight: 850; text-transform: uppercase; }
    .founder-ops-detail-grid dd { margin: .2rem 0 0; color: var(--bs-text-primary); font-size: .7rem; overflow-wrap: anywhere; }
    .founder-review-periods { padding: .7rem; border: 1px solid var(--bs-border); background: var(--bs-surface-elevated); }
