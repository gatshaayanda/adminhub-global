    .founder-ops-search > div { display: flex; align-items: center; gap: .45rem; padding: 0 .65rem; border: 1px solid var(--bs-border-strong); background: var(--bs-surface-elevated); }
    .founder-ops-search input { flex: 1; min-width: 0; min-height: 44px; border: 0; outline: 0; background: transparent; color: var(--bs-text-primary); }
    .founder-ops-controls select,
