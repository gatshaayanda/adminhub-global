    .beta-preview-week, .beta-preview-universe, .beta-preview-progress, .beta-preview-players, .beta-preview-return, .beta-preview-next, .beta-preview-failure { border-color: var(--bs-border); border-radius: var(--bs-radius-lg); background: var(--bs-surface); box-shadow: var(--bs-shadow-1); }
    .beta-preview-section-heading h2 { color: var(--bs-text); }
    .beta-preview-stat-grid article, .beta-preview-universe-grid article, .beta-preview-player-grid article, .beta-preview-progress-track article { border-color: var(--bs-border); border-radius: var(--bs-radius-sm); background: var(--bs-bg-subtle); }
    .beta-preview-stat-grid article :is(strong,p), .beta-preview-universe-grid article :is(strong,p), .beta-preview-player-grid article :is(h3,strong,p), .beta-preview-progress-track article strong { color: var(--bs-text); }
    .beta-preview-highlight { border: 0; border-left: 5px solid var(--bs-blue); border-radius: 0 var(--bs-radius-sm) var(--bs-radius-sm) 0; background: var(--bs-blue-soft); }
    .beta-preview-highlight :is(strong,p) { color: var(--bs-text); }
    .beta-preview-private-rule, .beta-preview-social-lock { color: var(--bs-text-secondary); }
    .beta-preview-return { box-shadow: none; }
    .beta-preview-sticky-access { border-color: var(--bs-border-strong); border-radius: 16px; background: var(--bs-surface-dark); box-shadow: var(--bs-shadow-2); }
    
    /* Public / Around BoardSignal: lead story, supporting moments, standouts. */
    .feed-hero { background: var(--bs-surface-dark); }
    .feed-hero :is(h1,p,.kicker) { color: var(--bs-text-on-dark); }
    .feed-hero .kicker { color: var(--bs-lime); }
    .universe-now-grid article, .coverage-card, .public-podium-section article { border-color: var(--bs-border); border-radius: var(--bs-radius-md); background: var(--bs-surface); box-shadow: none; }
    .universe-now-grid article:first-child { grid-column: span 2; border-top-width: 6px; }
    .coverage-card.coverage-wide { box-shadow: var(--bs-shadow-1); }
    .public-player-identity { border-color: var(--bs-border); }
    .public-player-identity h1 { color: var(--bs-text); }
    .public-coverage-lead { border: 0; border-radius: var(--bs-radius-lg); background: var(--bs-surface); box-shadow: var(--bs-shadow-1); }
    .public-coverage-lead > div:last-child { border-radius: var(--bs-radius-md); background: var(--bs-surface-dark); }
    .public-coverage-empty, .public-private-boundary { border-color: var(--bs-border); background: var(--bs-surface); }
    
