    .founder-ops-details[open] > summary { border-bottom: 1px solid var(--bs-border); }
    .founder-ops-detail-grid { display: grid; grid-template-columns: minmax(0,1.2fr) minmax(240px,.8fr); gap: 1rem; padding: .85rem; background: var(--bs-bg-subtle); }
