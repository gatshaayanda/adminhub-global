rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isBoardSignalAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);

      match /desks/{deskKey} {
        allow read, create, update, delete: if isOwner(userId);

        match /evidence/{positionId} {
          allow read, create, update, delete: if isOwner(userId);
        }
      }
    }

    match /publicPlayers/{chessPlayerId} {
      allow read: if true;
      allow write: if isBoardSignalAdmin();
    }

    match /publicCoverage/{coverageId} {
      allow read: if true;
      allow write: if isBoardSignalAdmin();
    }

    // Identity ownership maps and one-time auth tickets are server-only.
    match /chessPlayerAccounts/{playerId} {
      allow read, write: if false;
    }

    match /playerIdentityAliases/{alias} {
      allow read, write: if false;
    }

    match /authCompletionTickets/{ticketId} {
      allow read, write: if false;
    }

    // Founding Beta credentials contain salted hashes and are server-only.
    match /betaAccess/{playerId} {
      allow read, write: if false;
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow create, update: if request.auth == null && request.resource.data.admin_id == 'admin';
      allow delete: if request.auth == null && resource.data.admin_id == 'admin';
    }

    match /projects/{projectId} {
      allow read:
        if request.auth == null &&
        (resource.data.admin_id == 'admin' || resource.data.client_email != null);

      allow write: if request.auth == null && request.resource.data.admin_id == 'admin';

      match /messages/{messageId} {
        allow read: if true;
        allow create:
          if request.auth == null &&
          request.resource.data.sender is string &&
          request.resource.data.text is string &&
          request.resource.data.timestamp != null;

        allow delete: if request.auth == null;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
